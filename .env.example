# ============================================================
# 司印云打印 MCP 配置文件模板
# 用法：复制本文件为 .env，然后把下面的值改成你自己司印环境的参数
# 说明：每个司印部署环境的参数都不同，请逐项确认
# 注意：不要把这个 .env 文件提交到公开仓库（含内网地址和密钥）
# ============================================================

# ---------- 服务器 ----------
# 协议：https 或 http（内网一般用 https）
SIYIN_PROTOCOL=https

# 司印服务器 IP（每家的内网 IP 不同，务必改）
SIYIN_HOST=192.168.1.34

# 司印 Web 服务端口（默认 8110，若你的环境改过端口就改这里）
SIYIN_PORT=8110

# 上传接口路径（一般不用改，除非司印给你的是定制路径）
SIYIN_URI=/mobileproxy/web_upload

# ---------- 认证 ----------
# 登录账号（本地登录模式下填司印的账号名/工号）
SIYIN_LOGIN_ACCOUNT=1

# 登录域：
#   Sysprint_Local   = 本地登录
#   Sysprint_PINCode = PIN 码登录
#   Sysprint_POP3    = POP3 邮箱登录
#   域登录           = 填你们的域名
SIYIN_LOGIN_DOMAIN=Sysprint_Local

# ---------- 密钥 ----------
# 司印分配的解决方案密钥 solutionkey（每家不同，必填）
SIYIN_SOLUTIONKEY=

# ---------- 打印队列 ----------
# 打印机队列 ID（在司印后台的打印机/队列里查，每家不同，必填）
SIYIN_PRINTER_QUEUE=

# ---------- 打印方式 ----------
# 0 = 用户名密码登录打印（默认）
# 1 = 提取码打印
SIYIN_RELEASE_CODE_PRINT=0

# 打印完成后的回调地址（一般留空）
SIYIN_CALLBACK_URL=
